EXPO_PUBLIC_SUPABASE_URL=https://jmguyniibuifqnegdiso.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_project_publishable_key

# Page of the presentation site that email links land on and that opens the app (goworth-website/public/auth).
# Defaults to the GitHub Pages address; set it when the site moves to its own domain.
# EXPO_PUBLIC_AUTH_LINK_URL=https://a-ndrewi.github.io/goworth-website/auth/

# Support form (supabase/functions/contact-support):
# RESEND_API_KEY=re_...
# SUPPORT_EMAIL=delivered@resend.dev
# SUPPORT_FROM_EMAIL="GoWorth Support <onboarding@resend.dev>"

# Premium purchases through RevenueCat (public SDK keys, safe in EXPO_PUBLIC_):
# The Test Store key simulates purchases in development builds only; release builds crash if they find it.
# EXPO_PUBLIC_REVENUECAT_TEST_STORE_KEY=test_...
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_...
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_...

# Purchase sync (supabase/functions/revenuecat-sync), set as Supabase function secrets, never EXPO_PUBLIC_:
# REVENUECAT_SECRET_KEY=sk_...
# REVENUECAT_WEBHOOK_AUTH=<long random string, also pasted as the webhook Authorization header in RevenueCat>
# REVENUECAT_ENTITLEMENT_ID=premium
