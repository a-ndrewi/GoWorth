{
  "expo": {
    "name": "GoWorth",
    "slug": "goworth",
    "platforms": [
      "ios",
      "android"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/goworth/app-icon.png",
    "scheme": "goworth",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/goworth/app-icon.png",
      "bundleIdentifier": "com.andrewi.goworth",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/goworth/android-foreground.png",
        "monochromeImage": "./assets/images/goworth/android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.andrewi.goworth"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/goworth/splash.png",
          "imageWidth": 285,
          "dark": {
            "backgroundColor": "#131A26",
            "image": "./assets/images/goworth/splash-dark.png"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow GoWorth to find destinations and places near you.",
          "locationAlwaysAndWhenInUsePermission": "Allow GoWorth to tell you about places worth seeing when you arrive somewhere new, even while the app is closed.",
          "locationAlwaysPermission": "Allow GoWorth to tell you about places worth seeing when you arrive somewhere new, even while the app is closed.",
          "motionUsagePermission": false,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GoWorth to use a photo you choose as your profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false,
          "color": "#2457E6"
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "TripWidget",
              "displayName": "Current trip",
              "description": "Your active GoWorth trip at a glance.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "initialLayout": "./src/widgets/trip-widget.tsx"
              },
              "android": null
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2b91c2cf-8f40-4d81-bda9-0c0838d1960b"
      }
    },
    "owner": "a-ndrewi"
  }
}
